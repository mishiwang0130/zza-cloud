<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.wxy</groupId>
        <artifactId>rental</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>rental-api</artifactId>
    <packaging>jar</packaging>

    <name>rental-api</name>
    <description>rental 对外发布模块：跨服务 DTO、Feign 客户端接口与对外常量</description>
    <dependencies>
        <!-- 对外 DTO 迟早要用统一响应、分页与错误码；common-core 零外部依赖，代价为零 -->
        <dependency>
            <groupId>com.wxy</groupId>
            <artifactId>common-core</artifactId>
        </dependency>
        <!-- Feign 客户端接口需要 OpenFeign 注解；引用方本来就要用 Feign 调用，顺带获得客户端 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <!-- DTO 上的 @NotBlank / @NotNull 等约束注解：由提供方服务用 @Validated 校验入参 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!--
            熔断降级：@FeignClient(fallbackFactory = ...) 要真正生效，classpath 上必须有 Sentinel，
            并且引用方配置 feign.sentinel.enabled=true（自动配置会在漏配时打 WARN）。
        -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!--
        本期刻意不声明任何依赖：rental 没有要发布的 Feign 客户端、没有跨服务 DTO，
        common-core 在这里用不到。将来要发布 XxxClient / XxxDTO 时再照 infra-api 的 pom 补
        （common-core、spring-cloud-starter-openfeign、spring-boot-starter-validation、
        spring-cloud-starter-alibaba-sentinel），因为「发布了客户端」才真正需要这几样。
    -->
</project>
