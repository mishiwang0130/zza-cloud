<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.wxy</groupId>
        <artifactId>common</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>common-security</artifactId>
    <packaging>jar</packaging>

    <name>common-security</name>
    <description>认证公共能力：JWT 签发与解析、密钥配置；登录上下文在 common-core 的 UserContextHolder</description>

    <dependencies>
        <dependency>
            <groupId>com.wxy</groupId>
            <artifactId>common-core</artifactId>
        </dependency>
        <!--
            默认鉴权实现的两个依赖：
            读平台凭证缓存用 common-redis 的 RedisUtil，回源校验调 infra 的服务间接口（infra-api）。
            注意 common-* 之间「只依赖 common-core」是常态，这里是刻意的例外：
            默认实现本质上就是「替业务服务调 infra」，不引 infra-api 就没有契约可用。
        -->
        <dependency>
            <groupId>com.wxy</groupId>
            <artifactId>common-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wxy</groupId>
            <artifactId>infra-api</artifactId>
        </dependency>
        <!-- 远程调用的熔断降级：@SentinelResource 的切面由该 starter 装配 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
        </dependency>
        <!--
            只引 spring-boot-starter：JwtProperties 需要 @ConfigurationProperties，
            本模块不需要 Web（网关是 WebFlux、业务服务是 WebMVC，各自已经有了），
            避免把 Servlet 栈带进网关。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <!-- 签名实现与 JSON 编解码只在运行期需要，声明 runtime：不进引用方的编译期 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
