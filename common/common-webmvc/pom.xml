<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.wxy</groupId>
        <artifactId>common</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>common-webmvc</artifactId>
    <packaging>jar</packaging>

    <name>common-webmvc</name>
    <description>Servlet 栈的 Web 公共能力：全局异常处理、端前缀自动配置（/admin-api、/app-api）、参数校验、接口文档配置</description>

    <dependencies>
        <!-- 工程内模块：已在 dependencies 里登记，不写版本 -->
        <dependency>
            <groupId>com.wxy</groupId>
            <artifactId>common-core</artifactId>
        </dependency>
        <!-- 第三方依赖：版本由 dependencies 统一管理，不写 version -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
    </dependencies>

    <!--
        名字里带 mvc 是有意的：本模块是 Servlet 栈的，网关（WebFlux）不要引用，
        否则会把 spring-webmvc 带进响应式应用。网关用 common-core（将来可加 common-webflux）。
    -->
</project>
