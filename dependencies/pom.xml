<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        本模块是纯依赖管理（BOM），parent 必须是 spring-boot-starter-parent，不能是 zza-cloud：
        父工程以 import 方式引入本模块，如果本模块再继承父工程，Maven 会报
        "The dependencies of type=pom and with scope=import form a cycle"。
        <relativePath/> 表示父 pom 从仓库解析，不去上层目录找。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- 必须与根 pom 的 parent 版本一致：BOM 不能继承根 pom（会形成 import 循环） -->
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.wxy</groupId>
    <artifactId>dependencies</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>dependencies</name>
    <description>统一依赖版本管理（BOM）：所有依赖版本只在这里定义</description>

    <properties>
        <!-- Spring Cloud 官方组件（Gateway、OpenFeign、LoadBalancer、Bus、Resilience4j 等） -->
        <!-- 2025.0.x 的 Boot 基线是 3.5.x，与根 pom 的 Boot 3.5.16 配套 -->
        <spring-cloud.version>2025.0.3</spring-cloud.version>

        <!-- Spring Cloud Alibaba（Nacos、Sentinel、Seata、RocketMQ），2025.0.0.0 的父 BOM 是 spring-cloud-dependencies-parent 4.3.0（对应 Spring Cloud 2025.0.x） -->
        <spring-cloud-alibaba.version>2025.0.0.0</spring-cloud-alibaba.version>

        <!--
            Spring AI 与 Spring AI Alibaba：
            Spring AI Alibaba 的组件（这里只用 Redis 会话记忆）基于 Spring AI 1.1.2，
            所以两边版本必须对齐这一条线，否则会出现同一份 Spring AI 类被两个版本管理、编译期与运行期行为不一致。
            模型侧不用 Spring AI Alibaba：百炼工作空间只提供 OpenAI 兼容网关（DashScope 原生路径会 400），
            所以模型走 Spring AI 官方的 spring-ai-starter-model-openai（版本由 spring-ai-bom 管理）。
        -->
        <spring-ai.version>1.1.2</spring-ai.version>
        <spring-ai-alibaba.version>1.1.2.3</spring-ai-alibaba.version>

        <!-- 持久层 -->
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <druid.version>1.2.28</druid.version>

        <!-- 工具类 -->
        <hutool.version>5.8.32</hutool.version>
        <fastjson2.version>2.0.53</fastjson2.version>
        <jjwt.version>0.12.6</jjwt.version>
        <minio.version>8.5.12</minio.version>
        <aliyun-sms.version>2.0.0</aliyun-sms.version>

        <!-- 接口文档 -->
        <knife4j.version>4.5.0</knife4j.version>
        <!--
            Knife4j 4.5.0 自带的 springdoc 是 2.3.0，只支持到 Boot 3.3 线；
            Boot 3.5 必须用 springdoc 2.8.x，所以 common-webmvc 里要排除它自带的版本，
            由这里统一管理（见 common-webmvc/pom.xml 的 exclusion）。
        -->
        <springdoc.version>2.8.17</springdoc.version>

        <!-- 消息 -->
        <rocketmq-spring.version>2.3.6</rocketmq-spring.version>

        <!-- 其他 -->
        <lombok.version>1.18.42</lombok.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <!-- Redisson：分布式锁客户端（common-lock），3.52.0 对应 Spring Boot 3.5 / Spring Data Redis 3.5 线 -->
        <redisson.version>3.52.0</redisson.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- ==================== 0. 工程内模块（照芋道的做法登记，引用时不写版本） ==================== -->
            <!--
                新增工程内模块（例如 user-api）时，在这里补一行登记。
                版本与本模块自身版本一致（都等于根 pom 的版本），改版本时一起改。
            -->
            <dependency>
                <groupId>com.wxy</groupId>
                <artifactId>common-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wxy</groupId>
                <artifactId>common-webmvc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wxy</groupId>
                <artifactId>common-redis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wxy</groupId>
                <artifactId>common-mybatis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wxy</groupId>
                <artifactId>common-webflux</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wxy</groupId>
                <artifactId>common-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wxy</groupId>
                <artifactId>common-storage</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wxy</groupId>
                <artifactId>common-mq</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wxy</groupId>
                <artifactId>common-feign</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wxy</groupId>
                <artifactId>common-lock</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wxy</groupId>
                <artifactId>infra-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wxy</groupId>
                <artifactId>infra-biz</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wxy</groupId>
                <artifactId>rental-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wxy</groupId>
                <artifactId>rental-biz</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wxy</groupId>
                <artifactId>ai-agent-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wxy</groupId>
                <artifactId>ai-agent-biz</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- ==================== 1. BOM 导入 ==================== -->
            <!--
                顺序有意义：同名依赖以最先声明的 BOM 为准，所以 Spring Cloud 排在 Spring Cloud Alibaba 前面。
            -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring AI 核心 BOM：Spring AI 的组件版本以它为准，排在 Alibaba BOM 之前 -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring AI Alibaba BOM：Redis 会话记忆等 Alibaba 组件的版本以它为准 -->
            <dependency>
                <groupId>com.alibaba.cloud.ai</groupId>
                <artifactId>spring-ai-alibaba-bom</artifactId>
                <version>${spring-ai-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!--
                ==================== 2. 这些组件不要在这里重复声明 ====================
                下面组件的版本已经由上面两份 BOM（以及 spring-boot-starter-parent 带的
                spring-boot-dependencies）统一提供，业务模块直接写 groupId + artifactId 即可。

                尤其注意：不要“声明了但不写 version”，那样会把 BOM 里的版本顶掉，
                子模块会报 'dependencies.dependency.version' ... is missing。

                Spring Cloud 官方：
                    spring-cloud-starter-gateway
                    spring-cloud-starter-openfeign
                    spring-cloud-starter-loadbalancer
                    spring-cloud-starter-bus-amqp
                    spring-cloud-starter-circuitbreaker-resilience4j
                Spring Cloud Alibaba：
                    spring-cloud-starter-alibaba-nacos-discovery
                    spring-cloud-starter-alibaba-nacos-config
                    spring-cloud-starter-alibaba-sentinel
                    spring-cloud-starter-alibaba-seata
                    spring-cloud-starter-stream-rocketmq
                Spring Boot：
                    spring-boot-starter-web / webflux / validation / aop / actuator
                    spring-boot-starter-data-redis / cache / test
                    spring-boot-configuration-processor
                其他：
                    com.mysql:mysql-connector-j
            -->

            <!-- ==================== 3. 第三方依赖（BOM 未覆盖，在这里定版本） ==================== -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!--
                MyBatis-Plus 3.5.9 起把基于 JSqlParser 的插件（分页 PaginationInnerInterceptor、
                防全表更新 BlockAttackInnerInterceptor）拆到了这个模块，common-mybatis 的分页插件依赖它；
                版本必须与 mybatis-plus-spring-boot3-starter 完全一致。
            -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>druid-spring-boot-3-starter</artifactId>
                <version>${druid.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba.fastjson2</groupId>
                <artifactId>fastjson2</artifactId>
                <version>${fastjson2.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.minio</groupId>
                <artifactId>minio</artifactId>
                <version>${minio.version}</version>
            </dependency>
            <!-- 阿里云短信（号码认证服务）客户端，用于发送 app 端短信验证码 -->
            <dependency>
                <groupId>com.aliyun</groupId>
                <artifactId>dypnsapi20170525</artifactId>
                <version>${aliyun-sms.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.xiaoymin</groupId>
                <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
                <version>${knife4j.version}</version>
            </dependency>
            <!--
                springdoc 是 knife4j 的底层实现：Knife4j 自带的 2.3.0 不支持 Boot 3.5，
                这里统一管理 2.8.x，common-webmvc 引 knife4j 时排除其自带版本再用这个。
            -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-spring-boot-starter</artifactId>
                <version>${rocketmq-spring.version}</version>
            </dependency>
            <!-- 分布式锁：common-lock 使用，只有引 common-lock 的服务才会带上它 -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <!--
                Spring AI Alibaba 的 BOM 只托管 agentscope / graph / studio 等模块，
                Redis 会话记忆的 starter 与自动配置不在其中，所以在这里显式给版本
                （这也是 AGENTS.md 说的「BOM 没覆盖的才写明确版本」）。
            -->
            <dependency>
                <groupId>com.alibaba.cloud.ai</groupId>
                <artifactId>spring-ai-alibaba-starter-memory-redis</artifactId>
                <version>${spring-ai-alibaba.version}</version>
            </dependency>
            <!--
                注意：starter-memory-redis 只带 Redis 会话记忆的实现类与 Redis 客户端，
                真正的 @AutoConfiguration 在 autoconfigure-memory 里（它把各类记忆的自动配置放在一个模块，
                对具体实现的依赖标了 optional，所以必须显式引这一条）。
            -->
            <dependency>
                <groupId>com.alibaba.cloud.ai</groupId>
                <artifactId>spring-ai-alibaba-autoconfigure-memory</artifactId>
                <version>${spring-ai-alibaba.version}</version>
            </dependency>

            <!-- 对象转换：统一用 MapStruct，禁止 BeanUtil/BeanUtils（规范见 AGENTS.md） -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
                <scope>provided</scope>
            </dependency>
            <!-- Lombok 与 MapStruct 共存必需的桥接处理器 -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok-mapstruct-binding</artifactId>
                <version>${lombok-mapstruct-binding.version}</version>
                <scope>provided</scope>
            </dependency>

            <!-- Lombok：简化样板代码，scope 固定 provided -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
