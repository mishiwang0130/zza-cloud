<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wxy.infra.biz.mapper.InfraRoleMapper">

    <!--
        查询用户拥有的启用角色编码。
        只取启用角色：停用角色不应继续带来权限；关联表与角色表都要过滤逻辑删除，
        否则删过的授权会继续生效。
    -->
    <select id="selectRoleCodesByUserId" resultType="java.lang.String">
        SELECT DISTINCT r.code
        FROM infra_role r
                 INNER JOIN infra_user_role ur ON ur.role_id = r.id AND ur.is_delete = 0
        WHERE ur.user_id = #{userId}
          AND r.is_delete = 0
          AND r.status = 0
    </select>

</mapper>
