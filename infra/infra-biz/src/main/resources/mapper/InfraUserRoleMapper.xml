<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wxy.infra.biz.mapper.InfraUserRoleMapper">

    <!-- 查询用户已分配的角色 ID -->
    <select id="selectRoleIdsByUserId" resultType="java.lang.Long">
        SELECT ur.role_id
        FROM infra_user_role ur
        WHERE ur.user_id = #{userId}
          AND ur.is_delete = 0
    </select>

    <!-- 查询拥有某个角色的用户 ID，用于角色变更后清理这些用户的权限缓存 -->
    <select id="selectUserIdsByRoleId" resultType="java.lang.Long">
        SELECT ur.user_id
        FROM infra_user_role ur
        WHERE ur.role_id = #{roleId}
          AND ur.is_delete = 0
    </select>

    <!--
        物理删除用户的全部角色关联（含历史上被逻辑删除的残留行）。
        (user_id, role_id) 上有唯一键，逻辑删除的行仍占着唯一键，覆盖授权前必须先物理清掉，
        否则重新分配同一个角色会报 Duplicate entry。
    -->
    <delete id="deleteByUserId">
        DELETE
        FROM infra_user_role
        WHERE user_id = #{userId}
    </delete>

</mapper>
